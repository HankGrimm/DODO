# 复制为 .env。Expo 只会把 EXPO_PUBLIC_ 前缀的变量注入客户端。
# 注意：EXPO_PUBLIC_ 的值会被打包进前端代码，任何人都能看到。
# 大模型 Key 这样放只适合黑客松 Demo，正式环境必须由服务端代理调用。

# contracts 目录 npm run deploy 之后把打印的两个地址填到这里
EXPO_PUBLIC_ESCROW_ADDRESS=
EXPO_PUBLIC_SBT_ADDRESS=
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# 任意 OpenAI 兼容接口（OpenAI / DeepSeek / 千帆 兼容端点均可）。留空则退回规则排序。
EXPO_PUBLIC_LLM_BASE_URL=
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_MODEL=gpt-4o-mini
